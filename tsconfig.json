{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": true,
    "strict": true,
    "downlevelIteration": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "rootDir": "./src",
    "baseUrl": "./",
    "removeComments": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@config/*": ["./src/config/*"],
      "@server/*": ["./src/server/*"],
      "@lavalink/*": ["./src/lavalink/*"],
      "@commands/*": ["./src/commands/*"],
      "@interfaces/*": ["./src/interfaces/*"],
      "@utils/*": ["./src/utils/*"],
      "@shared/*": ["./public/*"],
      "@tests/*": ["./src/tests/*"]
    },
    "types": ["bun"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "tsup.config.ts",
    "tsup.config.js",
    "tsconfig-paths.js",
    "eslint.config.mjs",
    "bun-build.js",
    "es-build.js",
    "prisma.config.ts",
    "src/generated",
    "dist",
    "build"
  ]
}