{
  "name": "pona-player",
  "version": "1.0.0",
  "description": "Lightweight, high-performance Discord audio player — no Lavalink needed",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "bun:build": "bun build --outdir dist --target bun --minify --clean src/index.ts",
    "watch": "tsc -w",
    "dev": "bunx tsx watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@discordjs/collection": "^2.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "discord.js": "^14.25.1"
  },
  "peerDependencies": {
    "typescript": "^5",
    "discord.js": "^14.0.0",
    "ffmpeg-static": "^5.0.0",
    "opusscript": "^0.1.0",
    "sodium-native": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "ffmpeg-static": {
      "optional": true
    },
    "opusscript": {
      "optional": true
    },
    "sodium-native": {
      "optional": true
    }
  },
  "keywords": [
    "discord",
    "voice",
    "music",
    "player",
    "bun",
    "youtube"
  ],
  "license": "MIT"
}
