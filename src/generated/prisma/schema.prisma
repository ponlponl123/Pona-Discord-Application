generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model api_key {
  id                 Int            @id @default(autoincrement()) @db.UnsignedInt
  time               DateTime       @default(now()) @db.Timestamp(0)
  createby           String         @db.VarChar(50)
  key                String         @unique(map: "key") @default(dbgenerated("(uuid())")) @db.Char(36)
  permission         Int            @default(0) @db.UnsignedInt
  ratelimitpermin    Int            @default(60) @db.UnsignedInt
  allowedipaddresses String         @default("[]") @db.LongText
  expiredat          DateTime?      @db.Timestamp(0)
  isdisabled         DateTime?      @db.Timestamp(0)
  isdeleted          DateTime?      @db.Timestamp(0)
  api_key_logs       api_key_logs[]
}

model api_key_logs {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  time       DateTime @default(now()) @db.Timestamp(0)
  ip         String   @db.VarChar(45)
  user_agent String   @db.LongText
  key        String   @default(dbgenerated("(uuid())")) @db.Char(36)
  api_key    api_key  @relation(fields: [key], references: [key], onDelete: NoAction, onUpdate: NoAction, map: "FK_api_key_logs_api_key")

  @@index([key], map: "FK_api_key_logs_api_key")
}

model channel_notify_webhook {
  id             BigInt    @id @default(autoincrement())
  uuid           String    @unique(map: "uuid") @default(dbgenerated("(uuid())")) @db.Char(36)
  time           DateTime  @default(now()) @db.Timestamp(0)
  by             String    @db.VarChar(50)
  guild_id       String    @db.VarChar(50)
  broadcaster_id String    @db.VarChar(256)
  webhook_url    String    @db.VarChar(512)
  message        String    @db.LongText
  verify_type    String?   @db.LongText
  verify_code    String?   @db.VarChar(512)
  hmac_secret    String?   @db.LongText
  lease_sec      Int?      @default(0)
  disabled       DateTime? @db.Timestamp(0)
  deleted        DateTime? @db.Timestamp(0)
}

model favorite_track {
  id                BigInt    @id @default(autoincrement())
  uid               String    @db.Text
  time              DateTime  @default(now()) @db.Timestamp(0)
  target            String    @db.Text
  source            String    @db.Text
  cache             String?   @db.LongText
  cache_lastupdated DateTime? @db.Timestamp(0)

  @@unique([uid(length: 100), target(length: 100)], map: "unique user/track")
}

model feedback {
  id      Int      @id @default(autoincrement())
  time    DateTime @default(now()) @db.Time(0)
  message String   @db.LongText
  email   String?  @db.VarChar(255)
}

model guilds {
  id      BigInt  @id @default(autoincrement())
  guildid String  @db.Text
  args    String? @db.LongText

  @@unique([guildid(length: 100)], map: "guildid")
}

model player_action_history {
  id          BigInt   @id @default(autoincrement())
  actionby    String   @db.Text
  timestamp   DateTime @default(now()) @db.Timestamp(0)
  action_name String   @db.Text
  data        String?  @db.LongText
  guild       String?  @db.Text
  channel     String?  @db.Text
}

model player_track_history {
  id           BigInt   @id @default(autoincrement())
  requestby    String   @db.Text
  uniqueid     String   @db.Text
  time         DateTime @default(now()) @db.Timestamp(0)
  voicechannel String   @db.Text
  guildid      String   @db.Text
  track        String   @db.LongText
}

model pona_flipflop_state {
  id      BigInt   @id @default(autoincrement())
  time    DateTime @default(now()) @db.Timestamp(0)
  guildid String   @db.Text
  active  Boolean  @default(false)
}

model pona_heartbeat_interval {
  id        BigInt   @id @default(autoincrement())
  time      DateTime @default(now()) @db.Timestamp(0)
  clusterid String?  @db.Text
  shardid   String?  @db.Text
  ptm       Int      @default(-1)

  @@index([time, ptm], map: "fetch")
}

model pona_voicestate_history {
  id          BigInt   @id @default(autoincrement())
  guildid     String   @db.Text
  memberid    String   @db.Text
  channelid   String   @db.Text
  beforestate String?  @db.LongText
  afterstate  String?  @db.LongText
  date        DateTime @default(now()) @db.Timestamp(0)
  type        String   @db.Text
}

model search_history {
  id   BigInt   @id @default(autoincrement())
  uid  String   @db.Text
  time DateTime @default(now()) @db.Timestamp(0)
  text String   @db.Text
}

model subscribe_artist {
  id                BigInt    @id @default(autoincrement())
  uid               String    @db.Text
  target            String    @db.Text
  time              DateTime  @default(now()) @db.Timestamp(0)
  cache             String?   @db.LongText
  cache_lastupdated DateTime? @db.Timestamp(0)

  @@unique([uid(length: 100), target(length: 100)], map: "unique_uid_target")
}

model subscribe_news {
  id     BigInt   @id @default(autoincrement())
  uid    String   @db.Text
  time   DateTime @default(now()) @db.Timestamp(0)
  type   String   @db.TinyText
  target String   @db.Text

  @@unique([uid(length: 100), type(length: 100), target(length: 100)], map: "unique_uid_type_target")
}

model user_session {
  id                 BigInt   @id @default(autoincrement())
  uid                String   @unique(map: "uid") @db.VarChar(100)
  ytmusic_visitor_id String   @unique(map: "ytmusic_visitor_id") @db.VarChar(255)
  ytmusic_cookie     String?  @db.LongText
  language           String?  @db.VarChar(50)
  country            String?  @db.VarChar(10)
  timezone           String?  @db.VarChar(100)
  user_agent         String?  @db.LongText
  ip_address         String?  @db.VarChar(45)
  sec_ch_ua          String?  @db.LongText
  created_at         DateTime @default(now()) @db.Timestamp(0)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamp(0)
}
