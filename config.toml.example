# Global Configuration
# This file contains settings that apply to ALL environments
# Environment-specific files (config.development.toml, config.production.toml) 
# will override these values

title = "Pona! Discord Application"

# Add global settings here that should be shared across all environments
# Example:
# [app]
# name = "Pona Discord Bot"
# version = "0.2.2"

# [features]
# music_enabled = true
# moderation_enabled = true

# Redis TLS Configuration
# [redis.tls]
# enabled = false
# ca = "/path/to/redis-ca.crt"
# cert = "/path/to/redis-client.crt"
# key = "/path/to/redis-client.key"
# rejectUnauthorized = true

# Redis Sentinel TLS Configuration
# [redis.sentinel.tls]
# enabled = false
# ca = "/path/to/sentinel-ca.crt"
# cert = "/path/to/sentinel-client.crt"
# key = "/path/to/sentinel-client.key"
# rejectUnauthorized = true
