{
  "name": "pona-discord-application",
  "version": "0.2.2-optimized",
  "description": "A useful discord bot",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "type": "module",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "bin": "./dist/cli.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "type-check": "tsc --noEmit",
    "dev": "bun --watch src/index.ts",
    "start": "NODE_ENV=production CLUSTER=false node -r ./tsconfig-paths.js dist/index.js",
    "start-shard": "NODE_ENV=production CLUSTER=true node -r ./tsconfig-paths.js dist/shard.js",
    "lint": "eslint . -c .ts",
    "lint:fix": "eslint . -c .ts --fix",
    "build": "tsc --build",
    "format": "prettier --write .",
    "bun:start": "NODE_ENV=production RUNNER=bun AUTO_ROUTE=no bun dist/index.js --target node",
    "bun:start-shard": "NODE_ENV=production RUNNER=bun AUTO_ROUTE=no bun dist/shard.js --target node",
    "bun:start-reg": "NODE_ENV=production RUNNER=default AUTO_ROUTE=no bun dist/index.js --target node",
    "bun:start-reg-shard": "NODE_ENV=production RUNNER=default AUTO_ROUTE=no bun dist/shard.js --target node",
    "bun:build-reg": "bun build src/index.ts --outdir dist --clean --target node",
    "bun:build": "bunx tsup --config tsup.config.ts",
    "bun:build-legacy": "bunx tsc --build",
    "bun:lint": "bunx eslint . -c .ts",
    "bun:lint:fix": "bunx eslint . -c .ts --fix",
    "bun:format": "bunx prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponlponl123/Pona-Discord-Application.git"
  },
  "keywords": [
    "Ponlponl123",
    "Pona",
    "Discord",
    "Application",
    "Bot",
    "Dashboard",
    "Useful",
    "Helpful"
  ],
  "author": "Ponlponl123",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ponlponl123/Pona-Discord-Application/issues"
  },
  "homepage": "https://github.com/ponlponl123/Pona-Discord-Application#readme",
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/static": "^1.4.7",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sapphire/snowflake": "^3.5.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "axios": "^1.13.5",
    "base64-arraybuffer": "^1.0.2",
    "base64-js": "^1.5.1",
    "discord-hybrid-sharding": "^3.0.1",
    "discord.js": "^14.25.1",
    "elysia": "^1.4.25",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^5.9.3",
    "json-bigint": "^1.0.0",
    "mariadb": "^3.5.1",
    "opusscript": "^0.1.1",
    "socket.io": "^4.8.3",
    "socket.io-redis": "^6.1.1",
    "sodium-native": "^5.0.10",
    "tsconfig-paths": "^4.2.0",
    "ws": "^8.19.0",
    "xmlhttprequest-ts": "^1.0.1",
    "youtubei.js": "^16.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.9",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^25.3.0",
    "@types/socket.io-redis": "^3.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "0.27.3",
    "eslint": "^10.0.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^17.3.0",
    "pkgroll": "^2.26.3",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "overrides": {
    "@discordjs/opus": "npm:opusscript@^0.1.1"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always"
  }
}
